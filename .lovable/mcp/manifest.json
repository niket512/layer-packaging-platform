{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "layer-packaging-platform",
      "version": "0.1.0",
      "title": "Layer Packaging Platform"
    },
    "tools": [
      {
        "name": "list_product_categories",
        "title": "List product categories",
        "description": "List the packaging product categories Snaplogo currently sources from its verified manufacturer network.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_how_it_works",
        "title": "How Snaplogo works",
        "description": "Explain the five-step Snaplogo sourcing journey from brief to delivery.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_faqs",
        "title": "List FAQs",
        "description": "Answer common questions about Snaplogo: categories, MOQs, pricing, quality checks, timelines and commissions.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "submit_signup_request",
        "title": "Submit a Snaplogo sign-up request",
        "description": "Submit a sign-up / access request on behalf of a brand so the Snaplogo team can reach out. Requires the brand name, a contact email and a description of the packaging requirement.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "brand": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Brand or company name."
            },
            "email": {
              "type": "string",
              "minLength": 3,
              "maxLength": 255,
              "description": "Contact email address."
            },
            "requirement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "description": "What the brand needs, e.g. '5,000 stand-up pouches for a snacks launch'."
            }
          },
          "required": [
            "brand",
            "email",
            "requirement"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
